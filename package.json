{
  "name": "kira-telegram-bot",
  "version": "1.0.0",
  "description": "Kira — assistante IA de Shawn via Telegram",
  "main": "bot.js",
  "scripts": {
    "start": "node bot.js",
    "validate": "node validate.js",
    "diagnose": "node diagnose.js",
    "fix": "node fix.js",
    "sync-env": "node scripts/sync-env-render.js",
    "sync-env:dry": "node scripts/sync-env-render.js --dry-run",
    "enable-security": "node scripts/enable-github-security.js",
    "security-status": "node scripts/security-status.js",
    "doctor": "node scripts/doctor.js",
    "audit-history": "bash scripts/audit-history.sh",
    "test-parser": "node test_parser.js",
    "preflight": "npm run validate && npm run security-status",
    "test-cua": "node test_cua_driver.js",
    "test-cua:login": "node test_cua_driver.js --login",
    "test-cua:full": "node test_cua_driver.js --full",
    "test-cua:diag": "node test_cua_driver.js --diag",
    "install-playwright": "npx playwright install chromium --with-deps"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "dotenv": "^16.0.0",
    "node-telegram-bot-api": "^0.67.0",
    "pdf-lib": "^1.17.1"
  },
  "optionalDependencies": {
    "playwright": "^1.62.1"
  },
  "overrides": {
    "form-data": "^4.0.4",
    "qs": "^6.14.1",
    "tough-cookie": "^4.1.3",
    "uuid": "^14.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
